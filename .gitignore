node_modules/
dist/
*.log
.DS_Store
.vite/

# Fetched sample spaces are optional and large (Sponza alone is ~50 MB). They're
# pulled on demand via `npm run fetch-samples`, so keep them out of git. Only the
# small default sample (virtualcity/) is tracked so a fresh clone renders instantly.
/public/assets/samples/*
!/public/assets/samples/virtualcity/
/tmp-samples/

# Personal, machine-local Claude Code permission grants (and atomic-write temp files)
.claude/settings.local.json*
