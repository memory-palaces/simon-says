node_modules/
dist/
*.log
.DS_Store
.vite/

# Palaces saved to this machine via the local dev-server API (see vite.config.ts).
/saved/

# Fetched sample spaces are optional and large (Sponza alone is ~50 MB). They're
# pulled on demand via `npm run fetch-samples`, so keep them out of git. Only the
# small default sample (virtualcity/) is tracked so a fresh clone renders instantly.
/public/assets/samples/*
!/public/assets/samples/virtualcity/
!/public/assets/samples/street/
!/public/assets/samples/cave/
!/public/assets/samples/forest/
!/public/assets/samples/dungeon/
/tmp-samples/

# Personal, machine-local Claude Code permission grants (and atomic-write temp files)
.claude/settings.local.json*

# Local secrets (e.g. GITHUB_PAT for gh)
.env
.env.*
kanban/

# The kanban-md binary is a 13 MB build artifact — install it yourself (see kanban/README.md)
/bin/kanban-md
